# Copy to .env and fill in. Never commit real values.

# PostgreSQL 16+
DATABASE_URL="postgresql://nexora:change-me@localhost:5432/nexora"
# Separate database for integration tests (they truncate tables).
TEST_DATABASE_URL="postgresql://nexora:change-me@localhost:5432/nexora_test"

# Public URL of the app, no trailing slash.
APP_URL="http://localhost:3000"

# 32+ random characters. Generate with: openssl rand -base64 48
BETTER_AUTH_SECRET="replace-with-a-long-random-string"

# Stripe TEST mode. Leave both empty to run with payments disabled
# (checkout then explains that payments are not configured).
# Live keys (sk_live_...) are rejected at startup.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
