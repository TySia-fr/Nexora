// NEXORA data model.
// Conventions:
// - Money is stored as integer minor units (cents) next to an explicit currency.
// - Orders snapshot everything they need (names, SKUs, prices, address) so that
//   later catalog edits never change historical orders.
// - Stock lives on ProductVariant and is only ever changed with conditional
//   updates inside transactions (see src/server/inventory.ts).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  CUSTOMER
  ADMIN
}

enum Currency {
  EUR
}

enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum OrderStatus {
  PENDING_PAYMENT
  PAID
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  EXPIRED
  REFUNDED
}

enum ShippingMethod {
  STANDARD
  EXPRESS
}

enum CouponType {
  PERCENT
  FIXED
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

// ---------------------------------------------------------------------------
// Auth (field names follow better-auth's core schema)
// ---------------------------------------------------------------------------

model User {
  id            String   @id
  name          String
  email         String   @unique
  emailVerified Boolean  @default(false)
  image         String?
  role          Role     @default(CUSTOMER)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  sessions  Session[]
  accounts  Account[]
  addresses Address[]
  cart      Cart?
  wishlist  WishlistItem[]
  orders    Order[]
  reviews   Review[]
  auditLogs AuditLog[]

  stockMovements      StockMovement[]
  stockCountsOpened   StockCount[]    @relation("StockCountCreatedBy")
  stockCountsFinished StockCount[]    @relation("StockCountClosedBy")

  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model Address {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  fullName   String
  line1      String
  line2      String?
  postalCode String
  city       String
  country    String   @default("FR") // ISO 3166-1 alpha-2
  phone      String?
  isDefault  Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([userId])
}

// ---------------------------------------------------------------------------
// Catalog
// ---------------------------------------------------------------------------

model Category {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  description String
  position    Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  products    Product[]
  coupons     Coupon[]
  stockCounts StockCount[]
}

model Product {
  id          String        @id @default(cuid())
  slug        String        @unique
  name        String
  tagline     String
  description String
  categoryId  String
  category    Category      @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  status      ProductStatus @default(DRAFT)
  /// Array of { label, value } pairs, rendered as the spec table.
  specs       Json          @default("[]")
  /// Array of { title, body } pairs.
  features    Json          @default("[]")
  /// Denormalised count of units in paid orders; drives "popular" sorting.
  unitsSold   Int           @default(0)
  featured    Boolean       @default(false)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  variants  ProductVariant[]
  images    ProductImage[]
  reviews   Review[]
  wishlists WishlistItem[]

  @@index([categoryId, status])
  @@index([status, createdAt])
  @@index([status, unitsSold])
}

model ProductVariant {
  id           String   @id @default(cuid())
  productId    String
  product      Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  sku          String   @unique
  name         String
  colorHex     String?
  priceCents   Int
  currency     Currency @default(EUR)
  /// Units available to sell. A CHECK constraint keeps it >= 0. Every change is
  /// recorded in StockMovement, in the same transaction (ADR-0010).
  stock        Int      @default(0)
  /// Low-stock alert level for this variant.
  reorderPoint Int      @default(5)
  /// Unit cost excluding VAT, for inventory valuation and margins. Null = unknown.
  costCents    Int?
  position     Int      @default(0)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  images         ProductImage[]
  cartItems      CartItem[]
  orderItems     OrderItem[]
  stockMovements StockMovement[]
  countLines     StockCountLine[]

  @@index([productId])
  @@index([priceCents])
}

model ProductImage {
  id        String          @id @default(cuid())
  productId String
  product   Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variantId String?
  variant   ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  url       String
  alt       String
  width     Int
  height    Int
  position  Int             @default(0)

  @@index([productId, position])
  @@index([variantId])
}

// ---------------------------------------------------------------------------
// Cart & wishlist
// ---------------------------------------------------------------------------

/// A cart belongs either to a signed-in user or to a guest cookie token.
model Cart {
  id         String   @id @default(cuid())
  userId     String?  @unique
  user       User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  guestToken String?  @unique
  couponCode String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  items CartItem[]
}

model CartItem {
  id        String         @id @default(cuid())
  cartId    String
  cart      Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variantId String
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  quantity  Int
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@unique([cartId, variantId])
}

model WishlistItem {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, productId])
}

// ---------------------------------------------------------------------------
// Orders & payments
// ---------------------------------------------------------------------------

model Order {
  id             String         @id @default(cuid())
  /// Human-facing number, e.g. NX-10482.
  number         Int            @unique @default(autoincrement())
  userId         String?
  user           User?          @relation(fields: [userId], references: [id], onDelete: SetNull)
  email          String
  status         OrderStatus    @default(PENDING_PAYMENT)
  currency       Currency       @default(EUR)
  subtotalCents  Int
  discountCents  Int            @default(0)
  shippingCents  Int
  totalCents     Int
  couponId       String?
  coupon         Coupon?        @relation(fields: [couponId], references: [id], onDelete: SetNull)
  couponCode     String?
  shippingMethod ShippingMethod

  // Address snapshot
  shipFullName   String
  shipLine1      String
  shipLine2      String?
  shipPostalCode String
  shipCity       String
  shipCountry    String
  shipPhone      String?

  /// Stock is held for unpaid orders until this moment.
  reservedUntil DateTime?
  paidAt        DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  items          OrderItem[]
  payments       Payment[]
  stockMovements StockMovement[]

  @@index([userId, createdAt])
  @@index([status, createdAt])
  @@index([status, reservedUntil])
}

model OrderItem {
  id             String          @id @default(cuid())
  orderId        String
  order          Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variantId      String?
  variant        ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  productId      String
  productSlug    String
  productName    String
  variantName    String
  sku            String
  unitPriceCents Int
  quantity       Int
  lineTotalCents Int
  /// Unit cost (ex. VAT) when sold, so margins stay correct after costs change.
  unitCostCents  Int?

  @@index([orderId])
  @@index([variantId])
}

model Payment {
  id                String        @id @default(cuid())
  orderId           String
  order             Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  provider          String        @default("stripe")
  providerSessionId String        @unique
  providerIntentId  String?
  status            PaymentStatus @default(PENDING)
  amountCents       Int
  currency          Currency      @default(EUR)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  @@index([orderId])
}

/// Every processed Stripe event id, so redelivered webhooks are no-ops.
model ProcessedWebhookEvent {
  id          String   @id
  type        String
  processedAt DateTime @default(now())
}

// ---------------------------------------------------------------------------
// Marketing & moderation
// ---------------------------------------------------------------------------

model Coupon {
  id               String     @id @default(cuid())
  code             String     @unique
  type             CouponType
  /// Percent (1–100) for PERCENT, cents for FIXED.
  value            Int
  minSubtotalCents Int        @default(0)
  /// When set, the discount only applies to products in this category.
  categoryId       String?
  category         Category?  @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  startsAt         DateTime?
  endsAt           DateTime?
  maxRedemptions   Int?
  redemptionCount  Int        @default(0)
  isActive         Boolean    @default(true)
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  orders Order[]
}

model Review {
  id               String       @id @default(cuid())
  productId        String
  product          Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  userId           String
  user             User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  rating           Int
  title            String
  body             String
  status           ReviewStatus @default(PENDING)
  verifiedPurchase Boolean      @default(false)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  @@unique([productId, userId])
  @@index([productId, status])
}

model NewsletterSubscription {
  id               String    @id @default(cuid())
  email            String    @unique
  unsubscribeToken String    @unique
  createdAt        DateTime  @default(now())
  unsubscribedAt   DateTime?
}

model AuditLog {
  id        String   @id @default(cuid())
  actorId   String?
  actor     User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  action    String
  entity    String
  entityId  String
  data      Json     @default("{}")
  createdAt DateTime @default(now())

  @@index([entity, entityId])
  @@index([createdAt])
}

// ---------------------------------------------------------------------------
// Inventory (ADR-0010)
// ---------------------------------------------------------------------------

enum StockMovementReason {
  /// Stock present when the ledger started, or set when a variant is created.
  OPENING_BALANCE
  /// Goods received from a supplier.
  RECEIVED
  /// Taken by a checkout (the order now holds the units).
  ORDER_RESERVED
  /// Given back when an unpaid order was cancelled or expired.
  ORDER_RELEASED
  /// A customer return put back on the shelf.
  RETURNED
  /// Written off: damaged, lost or used for demos.
  DAMAGED
  /// Manual correction with a note.
  ADJUSTMENT
  /// Difference found by a stock count.
  COUNT_CORRECTION
}

/// Append-only ledger: the sum of `delta` per variant always equals its `stock`.
model StockMovement {
  id         String              @id @default(cuid())
  variantId  String
  variant    ProductVariant      @relation(fields: [variantId], references: [id], onDelete: Cascade)
  delta      Int
  /// Variant stock right after this movement (from UPDATE … RETURNING).
  stockAfter Int
  reason     StockMovementReason
  note       String?
  orderId    String?
  order      Order?              @relation(fields: [orderId], references: [id], onDelete: SetNull)
  countId    String?
  count      StockCount?         @relation(fields: [countId], references: [id], onDelete: SetNull)
  actorId    String?
  actor      User?               @relation(fields: [actorId], references: [id], onDelete: SetNull)
  createdAt  DateTime            @default(now())

  @@index([variantId, createdAt])
  @@index([reason, createdAt])
  @@index([createdAt])
}

enum StockCountStatus {
  OPEN
  COMMITTED
  CANCELLED
}

/// A physical stock-take. Expected quantities are frozen when it opens.
model StockCount {
  id          String           @id @default(cuid())
  number      Int              @unique @default(autoincrement())
  status      StockCountStatus @default(OPEN)
  /// Null = every active variant.
  categoryId  String?
  category    Category?        @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  note        String?
  createdById String?
  createdBy   User?            @relation("StockCountCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  closedById  String?
  closedBy    User?            @relation("StockCountClosedBy", fields: [closedById], references: [id], onDelete: SetNull)
  createdAt   DateTime         @default(now())
  closedAt    DateTime?

  lines     StockCountLine[]
  movements StockMovement[]

  @@index([status, createdAt])
}

model StockCountLine {
  id         String         @id @default(cuid())
  countId    String
  count      StockCount     @relation(fields: [countId], references: [id], onDelete: Cascade)
  variantId  String
  variant    ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  /// Units that should be on the shelf when the count opened: available stock plus
  /// units held by orders that have not shipped yet.
  expected   Int
  /// When `expected` was frozen. Movements after it make the line stale.
  baselineAt DateTime       @default(now())
  /// What was physically counted. Null until entered.
  counted    Int?
  updatedAt  DateTime       @updatedAt

  @@unique([countId, variantId])
}
